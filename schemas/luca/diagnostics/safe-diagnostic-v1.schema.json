{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luca.local/schemas/diagnostics/safe-diagnostic-v1.schema.json",
  "title": "Secret-safe Luca diagnostic V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "timestamp", "component", "operation", "status_code", "duration_ms", "retryable"],
  "properties": {
    "protocol": {"const": "luca.safe-diagnostic.v1"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "component": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "status_code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "resident_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "conversation_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "retryable": {"type": "boolean"}
  },
  "$comment": "message, detail, body, path, arbitrary maps, and raw identifiers are intentionally unrepresentable."
}
