{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luca.local/schemas/signing_broker/frame-v1.schema.json",
  "title": "Luca inherited signing-broker frame V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "session_epoch", "sequence", "request_id", "operation", "payload", "deadline_unix_ms"],
  "properties": {
    "protocol": {"const": "luca.signing.frame.v1"},
    "session_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "operation": {"const": "message.publish.v1"},
    "payload": {"$ref": "../message_publish/v1.schema.json#/$defs/request"},
    "deadline_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "$comment": "Runtime conformance requires an unexpired value no more than now plus 30000 ms."
    }
  },
  "$comment": "The RFC 8785 JSON object is limited to 131072 UTF-8 bytes before its u32-be length prefix."
}
