{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luca.local/schemas/backup_restore/owner-identity-v1.schema.json",
  "title": "Protected Luca owner identity inner manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "canonicalization", "bundle_id", "exported_at", "owner_pubkey", "owner_secret_nsec", "manifest_sha256"],
  "properties": {
    "format": {"const": "luca.owner.identity"},
    "version": {"const": 1},
    "canonicalization": {"const": "RFC8785"},
    "bundle_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "exported_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "owner_pubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_secret_nsec": {
      "type": "string",
      "pattern": "^nsec1[023456789acdefghjklmnpqrstuvwxyz]+$",
      "writeOnly": true,
      "$comment": "The desktop authority additionally validates Bech32 checksum and derives owner_pubkey before any write."
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "$comment": "SHA-256 over RFC 8785 bytes with manifest_sha256 omitted."
    }
  }
}
