{
  "manifest_version": 3,
  "name": "Polyphonic browser awareness candidate",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "description": "Explicit, profile-paired browser references for one Polyphonic companion.",
  "key": "",
  "permissions": ["storage", "nativeMessaging", "activeTab", "scripting"],
  "optional_permissions": ["history", "bookmarks"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "incognito": "not_allowed",
  "externally_connectable": {"ids": [], "matches": []},
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Polyphonic browser awareness"}
}
