{
  "name": "polyphonic-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs && node scripts/verify-demo.mjs && node scripts/verify-release.mjs",
    "capture": "node scripts/capture.mjs",
    "audit:performance": "lighthouse http://127.0.0.1:8744/ --chrome-flags=\"--headless\" --output=json --output-path=audit/lighthouse-mobile-final.json --quiet"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "lighthouse": "13.4.1",
    "playwright": "1.62.1"
  }
}
